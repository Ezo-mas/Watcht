NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me

# Local-only bypass for development sign-in.
AUTH_ENABLE_LOCAL_BYPASS=true

# OAuth providers
# Google Cloud Console -> OAuth client -> Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# GitHub Developer Settings -> OAuth App -> Authorization callback URL:
# http://localhost:3000/api/auth/callback/github
GITHUB_ID=replace-me
GITHUB_SECRET=replace-me

# Database / runtime services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watcht
REDIS_URL=redis://localhost:6379
TMDB_API_KEY=replace-me
JOB_SECRET=replace-me
